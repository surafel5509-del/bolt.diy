{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "remix",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "installCommand": "pnpm install --no-frozen-lockfile && pnpm add @vercel/remix@2.16.7 --save",
  "buildCommand": "pnpm run build"
}
